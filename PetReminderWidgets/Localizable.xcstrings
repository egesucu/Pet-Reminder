    "Follow today's meals. Tap Morning or Evening to update or undo a feeding.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow today's meals. Tap Morning or Evening to update or undo a feeding."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge die heutigen Mahlzeiten. Tippe auf Morgen oder Abend, um eine Fütterung einzutragen oder rückgängig zu machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue las comidas de hoy. Toca Mañana o Noche para registrar o deshacer una comida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez les repas du jour. Touchez Matin ou Soir pour enregistrer ou annuler un repas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui i pasti di oggi. Tocca Mattina o Sera per registrare o annullare un pasto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün öğünlerini takip edin. Beslemeyi kaydetmek veya geri almak için Sabah ya da Akşam öğesine dokunun."
          }
        }
      }
    }
