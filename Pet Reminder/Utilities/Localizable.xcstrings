    "donate_us_comment" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Spende ist völlig freiwillig. Wir werden dafür weder Werbung einblenden noch deine Aufmerksamkeit darauf lenken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note that the donation is completely optional. We will never pop up an ad or get your attention to here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ten en cuenta que la donación es totalmente opcional. Nunca te mostraremos anuncios ni intentaremos llamar tu atención para conseguirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Veuillez noter que le don est entièrement facultatif. Nous n’afficherons jamais de publicité ni ne chercherons à attirer votre attention sur cette page."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La donazione è completamente facoltativa. Non mostreremo mai annunci né cercheremo di attirare qui la tua attenzione."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bağışın opsiyonel olduğunu unutma. Bunun için size asla reklam çıkarmayacağız veya ilginizi buraya çekmeye çalışmayacağız."
          }
        }
      }
    },
    "donate_us_context" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diese App begann als kostenlose App und ist es bis heute. Sie wurde von einem unabhängigen Entwickler als Hobbyprojekt ins Leben gerufen, um seine Fähigkeiten zu erproben. Dank jahrelanger Weiterentwicklung wurde sie inzwischen mehrere Hundert Mal heruntergeladen. Wir freuen uns sehr, dass du hier bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app began as a free app(and still is). This app is created from an indie developer as a hobby project to test its skills and supported through the years, it has become into an app with more than hundreds of downloads. We're so grateful to have you here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta app comenzó siendo gratuita (y todavía lo es). Fue creada por un desarrollador independiente como proyecto personal para poner a prueba sus habilidades, y gracias al apoyo recibido a lo largo de los años, se ha convertido en una app con cientos de descargas. Estamos muy agradecidos de tenerte aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cette app a été lancée gratuitement (et l’est toujours). Elle a été créée par un développeur indépendant comme projet personnel afin de mettre ses compétences à l’épreuve. Soutenue au fil des ans, elle compte désormais plusieurs centaines de téléchargements. Nous sommes très heureux de vous compter parmi nous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa app è nata come app gratuita (e lo è ancora). È stata creata da uno sviluppatore indipendente come progetto personale per mettere alla prova le proprie capacità e, grazie al supporto ricevuto negli anni, è diventata un’app con centinaia di download. Siamo davvero felici di averti qui."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulama ücretsiz bir uygulama olarak başladı(Hala da ücretsiz). Bu uygulama tek bir geliştirici tarafından hobi olarak ve yeteneklerini geliştirmek adına yaratıldı ve hala desteklenmeye devam ediyor. Uygulama yüzlerce insanın indirip kullandığı bir noktaya ulaştı. Burada olmanızdan ötürü çok memnunuz."
          }
        }
      }
    },
    "donate_us_donated" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du hast bereits gespendet, aber du kannst es gerne noch einmal tun, wenn du möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You already donated this before, you can do it again if you wish."
