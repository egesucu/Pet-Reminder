    "notification_birthday_content %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ hat heute Geburtstag! Alles Gute, Freund – hier gibt’s eine kostenlose Umarmung und ein Pfoten-High-Five."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ born today. Happy birthday friend, here's a free hug and paw-five."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ cumple años hoy. Feliz cumpleaños, amigo; aquí tienes un abrazo y un choque de patas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est l’anniversaire de %@ aujourd’hui. Bon anniversaire ! Voici un câlin et un tope-là de patte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi è il compleanno di %@. Buon compleanno, amico: ecco un abbraccio e un batticinque di zampa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bugün doğdu. Doğumgünün kutlu olsun dost, bizden sana ücretsiz bir sarılma ve pati-beşlik."
          }
        }
      }
    },
    "notification_content %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dein Freund %@ braucht Futter und Wasser. Vergiss es nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your friend %@ needs food and water. Don't forget."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu amigo %@ necesita comida y agua. No lo olvides."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compagnon %@ a besoin de nourriture et d’eau. Ne l’oubliez pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo amico %@ ha bisogno di cibo e acqua. Non dimenticarlo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkadaşın %@ su ve yemeğe muhtaç. Onu Unutma."
          }
        }
      }
    },
