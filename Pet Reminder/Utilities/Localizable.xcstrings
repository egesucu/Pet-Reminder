    "welcome_context" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Willkommen bei Pet Reminder. Hier kannst du dich um deinen kleinen Freund kümmern. Du kannst seine tägliche Fütterung verwalten und Erinnerungen für ihn erstellen. Bist du bereit? Fangen wir an, indem wir deinen ersten Freund hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to Pet Reminder. You can manage your little friend here. You can manage their daily feed and create reminder events for them. Are you ready? Let's start by adding your first friend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te damos la bienvenida a Pet Reminder. Aquí puedes cuidar de tu pequeño amigo, gestionar sus comidas diarias y crear eventos de recordatorio para él. ¿Todo listo? Empecemos añadiendo a tu primer amigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue dans Pet Reminder. Ici, vous pouvez prendre soin de votre petit compagnon, gérer ses repas quotidiens et créer des événements de rappel pour lui. Prêt à commencer ? Ajoutez votre premier compagnon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti diamo il benvenuto in Pet Reminder. Qui puoi prenderti cura del tuo piccolo amico, gestire i suoi pasti quotidiani e creare eventi promemoria per lui. Sei pronto? Iniziamo aggiungendo il tuo primo amico."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pet Reminder'a hoşgeldin. Burada küçük dostlarını yönetebilirsin. Onların günlük ihtiyaçlarını yönetebilir ve onlar için etkinlikler oluşturabilirsin. Hazır mısın? Hadi ilk dostunu ekleyerek başlayalım."
          }
        }
      }
    },
